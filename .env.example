# Copy to `.env.local` for local dev.

# Local WordPress (Docker on port 8080). Used by Next.js for REST API + media proxy.
WORDPRESS_URL=http://localhost:8080

# Veteran application → Resend (server-side only).

# Create at https://resend.com/api-keys (sign up free, then API Keys → Create API Key).
# Must be named RESEND_API_KEY — do NOT use NEXT_PUBLIC_ (that would expose the key in the browser).
RESEND_API_KEY=

# Must be an address on a domain you verified in Resend (Domains).
RESEND_FROM_EMAIL=

# Optional — defaults to sara@combatveteranstocareers.org
# VETERAN_APPLICATION_NOTIFY_TO=
